# Foundry resource URL; keep /openai/v1 for OpenAI Decisions and GPT Responses.
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_GPT_DEPLOYMENT=
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# OpenAI Decisions on Foundry uses the same Entra identity as Decision-1.
# Set the deployment name, which may differ from the underlying model name.
AZURE_OPENAI_DECISION_DEPLOYMENT=gpt-6-luna

# Decision-1 uses /providers/microsoft/v1/systemone on the resource endpoint.
# Use the account's properties.endpoint from Azure for the Decision resource.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_RESOURCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DECISION_ENDPOINT=

GPT_REASONING_EFFORT=none
GPT_MAX_OUTPUT_TOKENS=1024
PORT=3000

# Local development: run az login. Azure hosting: use a managed identity.
# Alternatively, uncomment all three for an Entra service principal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# All Foundry endpoints use Entra ID; no OpenAI API key is needed.
