# Foundry resource URL; use your resource name. Keep /openai/v1 for GPT.
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_GPT_DEPLOYMENT=
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# OpenAI Decisions opponent. Kept on the server, never sent to the browser.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna

# Decision-1 uses /providers/microsoft/v1/systemone on the resource endpoint.
# A project URL also works: the server extracts the resource origin.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_RESOURCE_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_DECISION_ENDPOINT=

GPT_REASONING_EFFORT=none
GPT_MAX_OUTPUT_TOKENS=1024
PORT=3000

# Local development: run az login. Azure hosting: use a managed identity.
# Alternatively, uncomment all three for an Entra service principal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Foundry uses Entra ID; OPENAI_API_KEY is only for the OpenAI Decisions opponent.
